# no trailing slash: with one, git ignores the DIRECTORY and happily commits a
# symlink of the same name, which is how a link to one machine's absolute path
# reached main on 12 Oct 2026
node_modules
out/
.DS_Store
*.otf
*.ttf

# Posters and maps: exports, rebuilt by tools/poster.py and bin/vv.mjs. The repo has never
# tracked a PDF, and the other repos keep renders out the same way.
*.pdf
